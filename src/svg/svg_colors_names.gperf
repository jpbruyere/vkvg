%struct-type
%language=ANSI-C
%readonly-tables
%ignore-case
%global-table
%define lookup-function-name lookup_svg_color_names_default
%define hash-function-name hash_svg_color
%define constants-prefix SVG_COL__
%define word-array-name svg_color_wordlist

struct SvgColorName;
